# Copy this file to  .env  and fill in the values you have.
# Anything left blank is simply switched off. Nothing breaks.
#
#   .env is gitignored. Set the same values in Netlify under
#   Site configuration > Environment variables so the live build gets them.

# Google Analytics 4 measurement ID.  analytics.google.com
# Admin > Data streams > your stream > Measurement ID.  Looks like G-ABC1234XYZ
VITE_GA_ID=

# Microsoft Clarity project ID.  clarity.microsoft.com
# Settings > Overview > Clarity project id.  Looks like abcde12345
VITE_CLARITY_ID=

# ---------------------------------------------------------------------------
# THE IMPORTANT ONE. The Google Apps Script web app address, ending in /exec.
#
# This is where form submissions go, and where the sponsor of the month is read
# from. Without it, forms fall back to Netlify Forms and the sponsor falls back
# to whatever is in src/data.js — the site still works, it just cannot be
# updated without a rebuild.
#
# Get it from the spreadsheet: Extensions > Apps Script > Deploy >
# Manage deployments > the Web app URL. Looks like:
#   https://script.google.com/macros/s/AKfy...long.../exec
#
# No "?key=" on the end any more. The old shared secret was appended here,
# which meant it shipped inside the browser bundle where anyone could read it.
# A password printed on the thing it protects is not a password.
VITE_SHEET_ENDPOINT=

# Keep posting a second copy of every submission to Netlify Forms as well.
# Leave this as "true" until the spreadsheet and Netlify have been seen to
# agree for a month, then set it to false and Netlify Forms can be retired.
VITE_KEEP_NETLIFY_FORMS=true

# Only if forms ever move to a third-party backend (Formspree, Web3Forms).
# When set it takes over completely and the two settings above are ignored.
VITE_FORM_ENDPOINT=
